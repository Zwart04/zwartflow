{
  "version": 6,
  "ui": {
    "preferred_provider": "codex-cli",
    "confirm_before_run": true
  },
  "router": {
    "simple_threshold": -1,
    "heavy_threshold": 4,
    "max_parallel_workers": 4
  },
  "providers": {
    "codex-cli": {
      "name": "Codex CLI",
      "vendor": "OpenAI",
      "kind": "cli",
      "executable_candidates": ["codex.exe", "codex.cmd", "codex", "%LOCALAPPDATA%\\OpenAI\\Codex\\bin\\*\\codex.exe"],
      "desktop_candidates": [],
      "discover": {
        "type": "command_json",
        "command": ["debug", "models"],
        "timeout": 45
      },
      "run": {
        "command": ["exec", "--model", "{model}", "{prompt}"]
      }
    },
    "codex-app": {
      "name": "Codex App",
      "vendor": "OpenAI",
      "kind": "desktop",
      "store": "^OpenAI\\.Codex$",
      "executable_candidates": [],
      "desktop_candidates": [
        "%LOCALAPPDATA%\\Microsoft\\WindowsApps\\codex.exe",
        "%LOCALAPPDATA%\\Microsoft\\WindowsApps\\OpenAI.Codex_*\\codex.exe"
      ]
    },
    "claude-cli": {
      "name": "Claude CLI",
      "vendor": "Anthropic",
      "kind": "cli",
      "executable_candidates": ["claude.exe", "claude.cmd", "claude", "%APPDATA%\\Claude\\claude-code\\*\\*\\claude.exe", "%APPDATA%\\Claude\\claude-code\\*\\claude.exe", "%USERPROFILE%\\.local\\bin\\claude.exe"],
      "desktop_candidates": [],
      "discover": {
        "type": "aliases",
        "aliases": [
          { "id": "haiku", "label": "Haiku", "tier": "fast" },
          { "id": "sonnet", "label": "Sonnet", "tier": "balanced" },
          { "id": "opus", "label": "Opus", "tier": "heavy" }
        ],
        "note": "Claude CLI tidak punya command resmi untuk list model non-interaktif; ditampilkan sebagai alias."
      },
      "run": {
        "command": ["-p", "--model", "{model}", "{prompt}"]
      }
    },
    "claude-app": {
      "name": "Claude App",
      "vendor": "Anthropic",
      "kind": "desktop",
      "store": "^Claude$",
      "executable_candidates": [],
      "desktop_candidates": [
        "%LOCALAPPDATA%\\Microsoft\\WindowsApps\\claude-desktop.exe",
        "%LOCALAPPDATA%\\Microsoft\\WindowsApps\\Claude_*\\claude-desktop.exe"
      ]
    },
    "antigravity-cli": {
      "name": "Antigravity CLI",
      "vendor": "Google",
      "kind": "cli",
      "executable_candidates": ["agy.exe", "agy.cmd", "agy", "%LOCALAPPDATA%\\agy\\bin\\agy.exe"],
      "desktop_candidates": [],
      "discover": {
        "type": "command_table",
        "command": ["models"],
        "timeout": 25
      },
      "run": {
        "command": ["-p", "{prompt}", "--model", "{model}"]
      }
    },
    "antigravity-app": {
      "name": "Antigravity IDE",
      "vendor": "Google",
      "kind": "desktop",
      "store": "^Antigravity( IDE)?$",
      "executable_candidates": [],
      "desktop_candidates": [
        "%LOCALAPPDATA%\\Programs\\Antigravity IDE\\Antigravity IDE.exe",
        "%LOCALAPPDATA%\\Programs\\Antigravity\\Antigravity.exe"
      ]
    },
    "gemini": {
      "name": "Gemini CLI",
      "vendor": "Google",
      "kind": "cli",
      "executable_candidates": ["gemini.exe", "gemini.cmd", "gemini"],
      "desktop_candidates": [],
      "discover": {
        "type": "aliases",
        "aliases": [
          { "id": "gemini-2.5-flash", "label": "2.5 Flash", "tier": "fast" },
          { "id": "gemini-2.5-pro", "label": "2.5 Pro", "tier": "heavy" }
        ],
        "note": "Alias resmi Google."
      },
      "run": {
        "command": ["-m", "{model}", "{prompt}"]
      }
    },
    "opencode": {
      "name": "OpenCode CLI",
      "vendor": "Community",
      "kind": "cli",
      "executable_candidates": ["opencode.exe", "opencode.cmd", "opencode", "%APPDATA%\\npm\\opencode.cmd"],
      "desktop_candidates": [],
      "discover": {
        "type": "command_table",
        "command": ["models"],
        "timeout": 20
      },
      "run": {
        "command": ["run", "--model", "{model}", "{prompt}"]
      }
    },
    "commandcode": {
      "name": "Command Code CLI",
      "vendor": "Command Code",
      "kind": "cli",
      "executable_candidates": ["cmdc.exe", "cmdc.cmd", "cmdc", "%APPDATA%\\npm\\cmdc.cmd"],
      "desktop_candidates": [],
      "discover": {
        "type": "command_table",
        "command": ["--list-models"],
        "timeout": 30
      },
      "run": {
        "command": ["-p", "-m", "{model}", "{prompt}"]
      }
    },
    "custom": {
      "name": "Custom Agent",
      "vendor": "Lainnya",
      "kind": "cli",
      "executable_candidates": [],
      "desktop_candidates": [],
      "discover": {
        "type": "aliases",
        "aliases": [
          { "id": "my-fast", "label": "Fast (edit config.json)", "tier": "fast" },
          { "id": "my-heavy", "label": "Heavy (edit config.json)", "tier": "heavy" }
        ],
        "note": "Isi path CLI + alias model di config.json."
      },
      "run": {
        "command": ["--model", "{model}", "{prompt}"]
      }
    }
  }
}
